{
  "manifest_version": 3,
  "name": "LingoLearn - İngilizce Çeviri & Kelime Öğrenme",
  "version": "1.2.0",
  "description": "Web sitelerindeki metinleri ve resimlerdeki İngilizce kelimeleri otomatik fark edip Türkçe'ye çevirin, dinleyin ve kelime defterinize kaydedin.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "offscreen.html", "offscreen.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
